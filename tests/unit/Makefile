.PHONY: all clean

all:
	$(MAKE) -C symbols all
	$(MAKE) -C graph all
	$(MAKE) -C lexer all
	$(MAKE) -C parser all
	$(MAKE) -C codegen all
	$(MAKE) -C project all

clean:
	$(MAKE) -C symbols clean
	$(MAKE) -C graph clean
	$(MAKE) -C lexer clean
	$(MAKE) -C parser clean
	$(MAKE) -C codegen clean
	$(MAKE) -C project clean
