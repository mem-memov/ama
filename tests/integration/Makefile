.PHONY: all clean

all:
	$(MAKE) -C 01-hello all
	$(MAKE) -C 02-branch all
	$(MAKE) -C 03-loop all
	$(MAKE) -C 04-indirect all
	$(MAKE) -C 05-break all
	$(MAKE) -C 06-values all
	$(MAKE) -C 07-reject-indirect-read all
	$(MAKE) -C 08-reject-indirect-write all
	$(MAKE) -C 09-reject-address-argument all
	$(MAKE) -C 10-reject-mem-alloc all
	$(MAKE) -C 11-reject-mem-free all
	$(MAKE) -C 12-reject-mem-load all
	$(MAKE) -C 13-reject-mem-store all
	$(MAKE) -C 14-intrinsics all
	$(MAKE) -C 15-call-control all
	$(MAKE) -C 16-reject-mixed-call all
	$(MAKE) -C 17-reject-unknown-param all
	$(MAKE) -C 18-reject-param-after-result all
	$(MAKE) -C 19-reject-extra-result all
	$(MAKE) -C 20-reject-blank-condition all
	$(MAKE) -C 21-reject-cycle all

clean:
	$(MAKE) -C 01-hello clean
	$(MAKE) -C 02-branch clean
	$(MAKE) -C 03-loop clean
	$(MAKE) -C 04-indirect clean
	$(MAKE) -C 05-break clean
	$(MAKE) -C 06-values clean
	$(MAKE) -C 07-reject-indirect-read clean
	$(MAKE) -C 08-reject-indirect-write clean
	$(MAKE) -C 09-reject-address-argument clean
	$(MAKE) -C 10-reject-mem-alloc clean
	$(MAKE) -C 11-reject-mem-free clean
	$(MAKE) -C 12-reject-mem-load clean
	$(MAKE) -C 13-reject-mem-store clean
	$(MAKE) -C 14-intrinsics clean
	$(MAKE) -C 15-call-control clean
	$(MAKE) -C 16-reject-mixed-call clean
	$(MAKE) -C 17-reject-unknown-param clean
	$(MAKE) -C 18-reject-param-after-result clean
	$(MAKE) -C 19-reject-extra-result clean
	$(MAKE) -C 20-reject-blank-condition clean
	$(MAKE) -C 21-reject-cycle clean
