# Generate the maintained C file/interface reference; this is not a handwritten
# replacement for it. Run from the repository root through `make docs`.
PROJECT_NAME           = Ama
PROJECT_BRIEF          = "Maintained C components and their specification contracts"
OUTPUT_DIRECTORY       = docs/technical
INPUT                  = docs/documentation.md src stdlib/modules tools tests spec docs/implementation/library-tests-and-build.md
USE_MDFILE_AS_MAINPAGE  = docs/documentation.md
RECURSIVE              = YES
FILE_PATTERNS          = *.c *.h *.inc *.py *.md
# Maintained .inc inputs are C; Doxygen otherwise parses this suffix as PHP.
EXTENSION_MAPPING      = inc=C
EXCLUDE_SYMLINKS       = YES
EXCLUDE_PATTERNS       = */build/* */generated/*
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION  = YES
REFERENCES_RELATION     = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = .
TIMESTAMP              = NO
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_PROGRAMLISTING     = NO
GENERATE_TAGFILE        = docs/technical/ama.tag
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
# Keep all declarations visible. The XML gate requires descriptions for every
# function/type; fields, macros and enum values use their enclosing type contract.
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = build/documentation/warnings.log
